const devices = [
  { id: 1, room: 1, watts: 1500 },
  { id: 2, room: 1, watts: 120 },
  { id: 3, room: 2, watts: 1200 },
  { id: 4, room: 2, watts: 10 },
  { id: 5, room: 3, watts: 200 },
  { id: 6, room: 3, watts: 1000 },
  { id: 7, room: 4, watts: 300 },
  { id: 8, room: 4, watts: 15 }
];

const start = new Date("2026-10-06T00:00:00Z");
const batch = [];

for (let day = 0; day < 7; day++) {
  for (let hour = 0; hour < 24; hour++) {
    const ts = new Date(start.getTime() + (day * 24 + hour) * 3600 * 1000);
    for (const d of devices) {
      const load = Math.random() * 0.5 + 0.4;
      const power = +(d.watts * load).toFixed(2);
      batch.push({
        device_id: d.id,
        room_id: d.room,
        timestamp: ts,
        readings: {
          power_watts: power,
          voltage: +(230 + (Math.random() - 0.5) * 4).toFixed(1),
          current_amps: +(power / 230).toFixed(2),
          energy_kwh: +(power / 1000).toFixed(4)   
        },
        status: load > 0.45 ? "ON" : "STANDBY",
        firmware: "sim-1.0",
        signal_strength_dbm: -Math.floor(Math.random() * 30 + 40)
      });
    }
  }
}
smartDb.sensor_logs.insertMany(batch);

print("Documents inserted: " + smartDb.sensor_logs.countDocuments());

smartDb.sensor_logs.createIndex({ device_id: 1, timestamp: -1 }, { name: "idx_device_time" });

smartDb.sensor_logs.createIndex({ timestamp: -1 }, { name: "idx_time" });

smartDb.sensor_logs.createIndex({ room_id: 1, timestamp: -1 }, { name: "idx_room_time" });

printjson(smartDb.sensor_logs.getIndexes());

print("\n-- Latest 5 readings, device 1");
smartDb.sensor_logs.find({ device_id: 1 }).sort({ timestamp: -1 }).limit(5).forEach(printjson);

print("\n-- Device 3, 12 Oct 2026");
smartDb.sensor_logs.find({
  device_id: 3,
  timestamp: { $gte: ISODate("2026-10-12T00:00:00Z"), $lt: ISODate("2026-10-13T00:00:00Z") }
}).forEach(printjson);

print("\n-- Readings with null power");
smartDb.sensor_logs.find({ "readings.power_watts": null }).forEach(printjson);

print("\n-- Total kWh per device");
smartDb.sensor_logs.aggregate([
  { $group: { _id: "$device_id", total_kwh: { $sum: "$readings.energy_kwh" }, readings: { $sum: 1 } } },
  { $project: { total_kwh: { $round: ["$total_kwh", 3] }, readings: 1 } },
  { $sort: { total_kwh: -1 } }
]).forEach(printjson);

print("\n-- Daily kWh per room");
smartDb.sensor_logs.aggregate([
  { $group: {
      _id: { room_id: "$room_id", day: { $dateToString: { format: "%Y-%m-%d", date: "$timestamp" } } },
      total_kwh: { $sum: "$readings.energy_kwh" }
  } },
  { $project: { total_kwh: { $round: ["$total_kwh", 3] } } },
  { $sort: { "_id.day": 1, "_id.room_id": 1 } }
]).forEach(printjson);

print("\n-- Query plan for device_id lookup");
printjson(
  smartDb.sensor_logs.find({ device_id: 1 }).sort({ timestamp: -1 }).explain("executionStats")
    .queryPlanner.winningPlan
);
