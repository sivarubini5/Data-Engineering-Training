from airflow import DAG
from airflow.providers.standard.operators.python import PythonOperator
from datetime import datetime, timedelta


def load_transactions():
    transactions = [
        {"id": 101, "amount": 500},
        {"id": 102, "amount": 1200},
        {"id": 103, "amount": 800}
    ]

    print("Transactions loaded:", transactions)
    return transactions


def validate_gateway(**context):
    attempt = context["ti"].try_number

    print("Gateway connection attempt:", attempt)

    if attempt == 1:
        raise Exception("Payment gateway unavailable")

    print("Gateway connection successful")
    return True


def process_payments(**context):
    transactions = context["ti"].xcom_pull(
        task_ids="load_transactions"
    )

    total = sum(t["amount"] for t in transactions)

    print("Payments processed:", total)
    return total


def generate_report(**context):
    total = context["ti"].xcom_pull(
        task_ids="process_payments"
    )

    print("PAYMENT PROCESSING REPORT")

    if total is None:
        print("Payment processing did not complete")
    else:
        print("Total Payments:", total)


with DAG(
    dag_id="payment_retry_pipeline",
    start_date=datetime(2025, 1, 1),
    schedule=None,
    catchup=False
) as dag:

    task1 = PythonOperator(
        task_id="load_transactions",
        python_callable=load_transactions
    )

    task2 = PythonOperator(
        task_id="validate_gateway",
        python_callable=validate_gateway,
        retries=1,
        retry_delay=timedelta(seconds=15)
    )

    task3 = PythonOperator(
        task_id="process_payments",
        python_callable=process_payments
    )

    task4 = PythonOperator(
        task_id="generate_report",
        python_callable=generate_report,
        trigger_rule="all_done"
    )

    task1 >> task2 >> task3 >> task4

EOF

