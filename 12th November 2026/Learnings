              docker exec -it airflow bash

              cd /opt/airflow/dags

              
              
              cat > retail_sales_dag.py <<'EOF'
              from airflow import DAG
              from airflow.providers.standard.operators.python import PythonOperator
              from datetime import datetime
              import csv
              
              
              def create_sales():
                  with open("/tmp/retail_sales.csv", "w") as f:
                      writer = csv.writer(f)
                      writer.writerow(["product", "quantity", "price"])
                      writer.writerow(["Rice", 10, 1200])
                      writer.writerow(["Oil", 5, 1500])
                      writer.writerow(["Sugar", 8, 800])
              
              
              def calculate_revenue():
                  total = 0
              
                  with open("/tmp/retail_sales.csv", "r") as f:
                      reader = csv.DictReader(f)
              
                      for row in reader:
                          total += int(row["quantity"]) * int(row["price"])
              
                  with open("/tmp/revenue_report.txt", "w") as f:
                      f.write(f"Total Revenue: {total}")
              
                  print("Total Revenue:", total)
              
              
              def show_report():
                  with open("/tmp/revenue_report.txt", "r") as f:
                      print(f.read())
              
              
              with DAG(
                  dag_id="retail_sales_pipeline",
                  start_date=datetime(2025, 1, 1),
                  schedule=None,
                  catchup=False
              ) as dag:
              
                  task1 = PythonOperator(
                      task_id="create_sales",
                      python_callable=create_sales
                  )
              
                  task2 = PythonOperator(
                      task_id="calculate_revenue",
                      python_callable=calculate_revenue
                  )
              
                  task3 = PythonOperator(
                      task_id="show_report",
                      python_callable=show_report
                  )
              
                  task1 >> task2 >> task3
              EOF
              
              
              python retail_sales_dag.py
               
              airflow dags list

