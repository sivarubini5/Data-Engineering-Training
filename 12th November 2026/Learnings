cat > warehouse_inventory_dag.py <<'EOF'
from airflow import DAG
from airflow.providers.standard.operators.python import PythonOperator
from datetime import datetime


def load_inventory():
    inventory = [
        {"product": "Laptop", "quantity": 5, "price": 55000, "reorder_level": 8},
        {"product": "Mouse", "quantity": 30, "price": 800, "reorder_level": 10},
        {"product": "Keyboard", "quantity": 4, "price": 1500, "reorder_level": 10},
        {"product": "Monitor", "quantity": 12, "price": 9000, "reorder_level": 5},
        {"product": "Dock", "quantity": 2, "price": 6000, "reorder_level": 6}
    ]

    print("Inventory loaded successfully")
    return inventory


def check_low_stock(**context):
    inventory = context["ti"].xcom_pull(task_ids="load_inventory")

    low_stock = [
        item["product"]
        for item in inventory
        if item["quantity"] < item["reorder_level"]
    ]

    print("Low stock products:", low_stock)
    return low_stock


def calculate_inventory_value(**context):
    inventory = context["ti"].xcom_pull(task_ids="load_inventory")

    total = sum(
        item["quantity"] * item["price"]
        for item in inventory
    )

    print("Total inventory value:", total)
    return total


def generate_report(**context):
    low_stock = context["ti"].xcom_pull(task_ids="check_low_stock")
    total = context["ti"].xcom_pull(task_ids="calculate_inventory_value")

    print("WAREHOUSE INVENTORY REPORT")
    print("--------------------------")
    print("Total Inventory Value:", total)
    print("Products Requiring Restock:", low_stock)


with DAG(
    dag_id="warehouse_inventory_pipeline",
    start_date=datetime(2025, 1, 1),
    schedule=None,
    catchup=False
) as dag:

    task1 = PythonOperator(
        task_id="load_inventory",
        python_callable=load_inventory
    )

    task2 = PythonOperator(
        task_id="check_low_stock",
        python_callable=check_low_stock
    )

    task3 = PythonOperator(
        task_id="calculate_inventory_value",
        python_callable=calculate_inventory_value
    )

    task4 = PythonOperator(
        task_id="generate_report",
        python_callable=generate_report
    )

    task1 >> task2 >> task4
    task1 >> task3 >> task4

EOF

