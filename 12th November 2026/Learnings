cat > courier_routing_dag.py <<'EOF'
from airflow import DAG
from airflow.providers.standard.operators.python import (
    PythonOperator,
    BranchPythonOperator
)
from datetime import datetime


def load_order():
    order = {
        "order_id": 701,
        "customer": "Mira",
        "distance_km": 18
    }

    print("Order received:", order)
    return order


def choose_delivery(**context):
    order = context["ti"].xcom_pull(
        task_ids="load_order"
    )

    if order["distance_km"] <= 30:
        return "local_delivery"
    else:
        return "outstation_delivery"


def local_delivery():
    print("Local courier assigned")


def outstation_delivery():
    print("Long-distance courier assigned")


with DAG(
    dag_id="courier_routing_pipeline",
    start_date=datetime(2025, 1, 1),
    schedule=None,
    catchup=False
) as dag:

    task1 = PythonOperator(
        task_id="load_order",
        python_callable=load_order
    )

    task2 = BranchPythonOperator(
        task_id="choose_delivery",
        python_callable=choose_delivery
    )

    task3 = PythonOperator(
        task_id="local_delivery",
        python_callable=local_delivery
    )

    task4 = PythonOperator(
        task_id="outstation_delivery",
        python_callable=outstation_delivery
    )

    task1 >> task2
    task2 >> [task3, task4]

EOF

python -m py_compile courier_routing_dag.py
airflow dags list

